<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IGCSE CS 0478 · Unit 6 Exam · Automated & Emerging Technologies</title>
<style>
/* ===== GOOGLE FONTS ===== */
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:ital,wght@0,400;0,500;1,400&family=Lora:ital,wght@0,400;0,500;1,400&display=swap');

/* ===== CSS VARIABLES ===== */
:root {
  --bg: #0b0f1a;
  --bg2: #111827;
  --bg3: #1a2236;
  --panel: #151d2e;
  --border: #1e2d47;
  --accent: #38bdf8;
  --accent2: #818cf8;
  --accent3: #34d399;
  --warn: #fb923c;
  --danger: #f87171;
  --success: #4ade80;
  --text: #e2e8f0;
  --text2: #94a3b8;
  --text3: #64748b;
  --gold: #fbbf24;
  --radius: 12px;
  --radius-lg: 20px;
  --shadow: 0 4px 32px rgba(0,0,0,0.5);
  --transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
}

/* ===== RESET ===== */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:'Lora',Georgia,serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  line-height:1.7;
  overflow-x:hidden;
}

/* ===== BACKGROUND GRID ===== */
body::before{
  content:'';
  position:fixed;
  inset:0;
  background-image:
    linear-gradient(rgba(56,189,248,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(56,189,248,0.03) 1px, transparent 1px);
  background-size:48px 48px;
  pointer-events:none;
  z-index:0;
}

/* ===== TYPOGRAPHY ===== */
h1,h2,h3,h4{font-family:'Syne',sans-serif;letter-spacing:-0.02em;}
code,pre,.mono{font-family:'DM Mono','Courier New',monospace;}

/* ===== SCROLLBAR ===== */
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}

/* ===== UTILITY ===== */
.hidden{display:none!important}
.flex{display:flex}
.flex-col{flex-direction:column}
.items-center{align-items:center}
.justify-between{justify-content:space-between}
.gap-2{gap:8px}
.gap-3{gap:12px}
.gap-4{gap:16px}
.text-center{text-align:center}
.w-full{width:100%}

/* ===== SCREENS ===== */
.screen{
  position:relative;
  z-index:1;
  min-height:100vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:24px;
}

/* ===== LANDING SCREEN ===== */
#screen-landing{
  background:radial-gradient(ellipse 80% 60% at 50% 0%, rgba(56,189,248,0.08) 0%, transparent 70%);
}
.landing-badge{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(56,189,248,0.08);
  border:1px solid rgba(56,189,248,0.25);
  border-radius:100px;
  padding:6px 16px;
  font-family:'DM Mono',monospace;
  font-size:0.75rem;
  color:var(--accent);
  margin-bottom:32px;
  letter-spacing:0.08em;
}
.landing-badge .dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--accent);
  animation:pulse 2s infinite;
}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.5;transform:scale(0.8)}}

.landing-title{
  font-size:clamp(2.4rem,6vw,4.5rem);
  font-weight:800;
  line-height:1.05;
  text-align:center;
  max-width:820px;
  margin-bottom:20px;
}
.landing-title span{
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
}
.landing-sub{
  font-size:1.1rem;
  color:var(--text2);
  text-align:center;
  max-width:560px;
  margin-bottom:40px;
  font-style:italic;
}
.stats-row{
  display:flex;gap:16px;flex-wrap:wrap;justify-content:center;
  margin-bottom:48px;
}
.stat-pill{
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:100px;
  padding:10px 22px;
  font-family:'DM Mono',monospace;
  font-size:0.85rem;
  color:var(--text2);
  display:flex;align-items:center;gap:8px;
}
.stat-pill strong{color:var(--accent);font-weight:500;}

.btn-primary{
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  color:#000;
  font-family:'Syne',sans-serif;
  font-weight:700;
  font-size:1.05rem;
  border:none;
  border-radius:100px;
  padding:16px 48px;
  cursor:pointer;
  transition:var(--transition);
  letter-spacing:0.02em;
  position:relative;
  overflow:hidden;
}
.btn-primary::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(255,255,255,0.2),transparent);
  opacity:0;transition:var(--transition);
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(56,189,248,0.35);}
.btn-primary:hover::before{opacity:1}
.btn-primary:active{transform:translateY(0)}

.btn-secondary{
  background:transparent;
  color:var(--text2);
  font-family:'Syne',sans-serif;
  font-weight:600;
  font-size:0.95rem;
  border:1px solid var(--border);
  border-radius:100px;
  padding:14px 36px;
  cursor:pointer;
  transition:var(--transition);
}
.btn-secondary:hover{border-color:var(--accent);color:var(--accent);}

/* ===== EXAM HEADER ===== */
.exam-header{
  position:sticky;top:0;z-index:100;
  background:rgba(11,15,26,0.92);
  backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);
  padding:12px 24px;
  display:flex;align-items:center;justify-content:space-between;
  flex-wrap:wrap;gap:12px;
}
.header-brand{
  font-family:'Syne',sans-serif;
  font-weight:800;
  font-size:0.9rem;
  color:var(--accent);
  letter-spacing:0.05em;
  text-transform:uppercase;
}
.timer-display{
  font-family:'DM Mono',monospace;
  font-size:1.4rem;
  font-weight:500;
  color:var(--text);
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:8px;
  padding:6px 16px;
  min-width:100px;
  text-align:center;
  transition:var(--transition);
}
.timer-display.warning{color:var(--warn);border-color:var(--warn);animation:timer-warn 1s infinite;}
.timer-display.danger{color:var(--danger);border-color:var(--danger);}
@keyframes timer-warn{0%,100%{opacity:1}50%{opacity:0.6}}

.progress-section{padding:0 24px 0;}
.progress-bar-wrap{
  background:var(--bg3);
  border-radius:100px;
  height:6px;
  overflow:hidden;
  margin:8px 0 4px;
}
.progress-bar-fill{
  height:100%;
  background:linear-gradient(90deg,var(--accent),var(--accent2));
  border-radius:100px;
  transition:width 0.5s ease;
}
.progress-label{
  font-family:'DM Mono',monospace;
  font-size:0.72rem;
  color:var(--text3);
  display:flex;justify-content:space-between;
}

/* ===== EXAM SCREEN ===== */
#screen-exam{
  display:none;
  flex-direction:column;
  min-height:100vh;
  padding:0;
  justify-content:flex-start;
  align-items:stretch;
}
#screen-exam.active{display:flex;}

.exam-body{
  flex:1;
  max-width:860px;
  width:100%;
  margin:0 auto;
  padding:32px 24px 120px;
}

/* Section divider */
.section-banner{
  display:flex;align-items:center;gap:16px;
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:16px 24px;
  margin-bottom:24px;
}
.section-icon{
  width:48px;height:48px;border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  font-size:1.4rem;
  flex-shrink:0;
}
.section-banner h2{font-size:1.3rem;font-weight:700;margin-bottom:2px;}
.section-banner p{font-size:0.85rem;color:var(--text2);}

/* Question card */
.question-card{
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:var(--radius-lg);
  padding:28px 32px;
  margin-bottom:20px;
  transition:var(--transition);
  animation:fadeUp 0.3s ease;
}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

.question-card:hover{border-color:rgba(56,189,248,0.2);}
.question-card.answered{border-color:rgba(56,189,248,0.15);background:rgba(56,189,248,0.02);}

.q-header{
  display:flex;align-items:flex-start;gap:12px;
  margin-bottom:18px;
}
.q-number{
  font-family:'DM Mono',monospace;
  font-size:0.75rem;
  font-weight:500;
  color:var(--accent);
  background:rgba(56,189,248,0.1);
  border:1px solid rgba(56,189,248,0.2);
  border-radius:6px;
  padding:4px 10px;
  white-space:nowrap;
  flex-shrink:0;
  margin-top:2px;
}
.q-marks{
  font-family:'DM Mono',monospace;
  font-size:0.72rem;
  color:var(--text3);
  border:1px solid var(--border);
  border-radius:6px;
  padding:4px 10px;
  white-space:nowrap;
  flex-shrink:0;
  margin-top:2px;
}
.q-text{
  font-size:1rem;
  line-height:1.75;
  color:var(--text);
  flex:1;
}
.q-text strong{color:var(--accent2);}

/* MCQ options */
.mcq-options{
  display:flex;flex-direction:column;gap:10px;
  margin-top:16px;
}
.mcq-option{
  display:flex;align-items:center;gap:12px;
  background:var(--bg3);
  border:1.5px solid var(--border);
  border-radius:10px;
  padding:12px 16px;
  cursor:pointer;
  transition:var(--transition);
  user-select:none;
}
.mcq-option:hover{border-color:var(--accent);background:rgba(56,189,248,0.05);}
.mcq-option.selected{border-color:var(--accent);background:rgba(56,189,248,0.08);}
.mcq-option.correct{border-color:var(--success);background:rgba(74,222,128,0.08);}
.mcq-option.incorrect{border-color:var(--danger);background:rgba(248,113,113,0.08);}
.mcq-option.revealed-correct{border-color:var(--success);background:rgba(74,222,128,0.06);}

.option-letter{
  width:28px;height:28px;border-radius:6px;
  background:var(--bg2);border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  font-family:'DM Mono',monospace;font-size:0.8rem;font-weight:500;
  color:var(--text2);flex-shrink:0;transition:var(--transition);
}
.mcq-option.selected .option-letter{background:var(--accent);border-color:var(--accent);color:#000;}
.mcq-option.correct .option-letter{background:var(--success);border-color:var(--success);color:#000;}
.mcq-option.incorrect .option-letter{background:var(--danger);border-color:var(--danger);color:#000;}
.mcq-option.revealed-correct .option-letter{background:var(--success);border-color:var(--success);color:#000;}

.option-text{font-size:0.95rem;line-height:1.5;}

/* Short answer textarea */
.answer-box{
  width:100%;
  background:var(--bg3);
  border:1.5px solid var(--border);
  border-radius:10px;
  padding:14px 16px;
  color:var(--text);
  font-family:'Lora',Georgia,serif;
  font-size:0.95rem;
  line-height:1.7;
  resize:vertical;
  min-height:100px;
  transition:var(--transition);
  outline:none;
  margin-top:14px;
}
.answer-box:focus{border-color:var(--accent);background:rgba(56,189,248,0.03);}
.answer-box.long-answer{min-height:200px;}
.char-count{
  font-family:'DM Mono',monospace;
  font-size:0.72rem;
  color:var(--text3);
  text-align:right;
  margin-top:4px;
}

/* Feedback panel */
.feedback-panel{
  margin-top:16px;
  background:var(--bg2);
  border:1px solid var(--border);
  border-radius:10px;
  padding:16px 20px;
  animation:fadeUp 0.3s ease;
}
.feedback-panel.correct-fb{border-color:rgba(74,222,128,0.3);}
.feedback-panel.partial-fb{border-color:rgba(251,146,60,0.3);}
.feedback-panel.wrong-fb{border-color:rgba(248,113,113,0.3);}

.fb-header{
  display:flex;align-items:center;gap:8px;
  font-family:'Syne',sans-serif;font-weight:700;font-size:0.9rem;
  margin-bottom:10px;
}
.fb-score{
  font-family:'DM Mono',monospace;
  font-size:1.1rem;
  font-weight:500;
  padding:2px 10px;
  border-radius:6px;
  margin-left:auto;
}
.correct-fb .fb-score{color:var(--success);background:rgba(74,222,128,0.1);}
.partial-fb .fb-score{color:var(--warn);background:rgba(251,146,60,0.1);}
.wrong-fb .fb-score{color:var(--danger);background:rgba(248,113,113,0.1);}

.fb-model-answer{
  font-size:0.9rem;
  color:var(--text2);
  line-height:1.7;
  border-top:1px solid var(--border);
  padding-top:10px;
  margin-top:10px;
}
.fb-model-answer strong{color:var(--accent2);}
.fb-keywords{
  display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;
}
.keyword-chip{
  font-family:'DM Mono',monospace;font-size:0.7rem;
  padding:3px 10px;border-radius:100px;
}
.keyword-chip.matched{background:rgba(74,222,128,0.12);color:var(--success);border:1px solid rgba(74,222,128,0.2);}
.keyword-chip.missed{background:rgba(248,113,113,0.1);color:var(--danger);border:1px solid rgba(248,113,113,0.2);}

.examiner-note{
  font-size:0.85rem;
  color:var(--text2);
  font-style:italic;
  margin-top:8px;
  padding:8px 12px;
  border-left:3px solid var(--accent2);
  background:rgba(129,140,248,0.05);
  border-radius:0 6px 6px 0;
}

/* ===== NAVIGATION BAR ===== */
.nav-footer{
  position:fixed;bottom:0;left:0;right:0;z-index:100;
  background:rgba(11,15,26,0.95);
  backdrop-filter:blur(20px);
  border-top:1px solid var(--border);
  padding:16px 24px;
  display:flex;align-items:center;justify-content:space-between;
  gap:12px;
}
.nav-btn{
  font-family:'Syne',sans-serif;font-weight:600;font-size:0.9rem;
  border-radius:10px;padding:12px 24px;
  border:1px solid var(--border);
  background:var(--panel);color:var(--text2);
  cursor:pointer;transition:var(--transition);
  display:flex;align-items:center;gap:6px;
}
.nav-btn:hover{border-color:var(--accent);color:var(--accent);}
.nav-btn:disabled{opacity:0.4;cursor:not-allowed;}

.submit-btn{
  font-family:'Syne',sans-serif;font-weight:700;font-size:0.95rem;
  border-radius:10px;padding:12px 32px;
  border:none;
  background:linear-gradient(135deg,var(--accent3),#0e9f6e);
  color:#000;cursor:pointer;transition:var(--transition);
}
.submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 24px rgba(52,211,153,0.35);}

.q-counter{
  font-family:'DM Mono',monospace;font-size:0.82rem;color:var(--text3);
  text-align:center;flex:1;
}

/* ===== RESULTS SCREEN ===== */
#screen-results{display:none;justify-content:flex-start;align-items:center;padding:0;}
#screen-results.active{display:flex;flex-direction:column;}

.results-container{
  max-width:900px;width:100%;
  padding:40px 24px 60px;
  margin:0 auto;
}

.results-hero{
  text-align:center;
  padding:48px 32px;
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:var(--radius-lg);
  margin-bottom:32px;
  position:relative;
  overflow:hidden;
}
.results-hero::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 60% 40% at 50% 0%,rgba(56,189,248,0.06),transparent);
  pointer-events:none;
}

.grade-badge{
  display:inline-flex;align-items:center;justify-content:center;
  width:100px;height:100px;
  border-radius:50%;
  font-family:'Syne',sans-serif;font-weight:800;font-size:2.8rem;
  margin-bottom:20px;
  position:relative;
  z-index:1;
}
.grade-A-star{background:linear-gradient(135deg,#fbbf24,#f59e0b);color:#000;box-shadow:0 0 40px rgba(251,191,36,0.4);}
.grade-A{background:linear-gradient(135deg,var(--accent),#0ea5e9);color:#000;box-shadow:0 0 40px rgba(56,189,248,0.4);}
.grade-B{background:linear-gradient(135deg,var(--accent2),#6366f1);color:#fff;box-shadow:0 0 40px rgba(129,140,248,0.4);}
.grade-C{background:linear-gradient(135deg,var(--accent3),#10b981);color:#000;box-shadow:0 0 40px rgba(52,211,153,0.3);}
.grade-D{background:linear-gradient(135deg,var(--warn),#ea580c);color:#000;}
.grade-F{background:linear-gradient(135deg,var(--danger),#dc2626);color:#fff;}

.total-score{
  font-family:'Syne',sans-serif;font-weight:800;font-size:3rem;
  margin-bottom:4px;
  background:linear-gradient(135deg,var(--text),var(--text2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.total-score span{font-size:1.5rem;color:var(--text3);-webkit-text-fill-color:var(--text3);}
.result-verdict{font-size:1.1rem;color:var(--text2);font-style:italic;margin-top:8px;}

/* Section cards */
.results-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-bottom:28px;}
.result-card{
  background:var(--panel);border:1px solid var(--border);
  border-radius:var(--radius);padding:24px;
  position:relative;overflow:hidden;
}
.result-card::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:3px;
  border-radius:0 0 var(--radius) var(--radius);
}
.result-card.mcq-card::after{background:linear-gradient(90deg,var(--accent),var(--accent2));}
.result-card.short-card::after{background:linear-gradient(90deg,var(--accent2),var(--accent3));}
.result-card.long-card::after{background:linear-gradient(90deg,var(--accent3),var(--warn));}

.rc-label{font-family:'DM Mono',monospace;font-size:0.7rem;letter-spacing:0.1em;color:var(--text3);text-transform:uppercase;margin-bottom:8px;}
.rc-score{font-family:'Syne',sans-serif;font-weight:800;font-size:2rem;margin-bottom:4px;}
.rc-pct{font-size:0.85rem;color:var(--text2);}
.rc-bar{background:var(--bg3);border-radius:100px;height:5px;margin-top:12px;overflow:hidden;}
.rc-bar-fill{height:100%;border-radius:100px;transition:width 1.5s ease;}
.mcq-card .rc-bar-fill{background:linear-gradient(90deg,var(--accent),var(--accent2));}
.short-card .rc-bar-fill{background:linear-gradient(90deg,var(--accent2),var(--accent3));}
.long-card .rc-bar-fill{background:linear-gradient(90deg,var(--accent3),var(--warn));}

/* Topic analysis */
.topic-section{
  background:var(--panel);border:1px solid var(--border);
  border-radius:var(--radius);padding:28px;margin-bottom:24px;
}
.topic-section h3{font-size:1.1rem;font-weight:700;margin-bottom:20px;display:flex;align-items:center;gap:8px;}
.topic-row{display:flex;align-items:center;gap:12px;margin-bottom:12px;}
.topic-name{font-size:0.9rem;color:var(--text2);min-width:180px;flex-shrink:0;}
.topic-bar-wrap{flex:1;background:var(--bg3);border-radius:100px;height:8px;overflow:hidden;}
.topic-bar-fill{height:100%;border-radius:100px;transition:width 1.5s ease;}
.topic-pct{font-family:'DM Mono',monospace;font-size:0.78rem;color:var(--text3);min-width:42px;text-align:right;}

/* Strength/weakness */
.sw-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;}
@media(max-width:600px){.sw-grid{grid-template-columns:1fr;}}
.sw-card{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);padding:20px;}
.sw-card.strength{border-top:2px solid var(--success);}
.sw-card.weakness{border-top:2px solid var(--danger);}
.sw-card h4{font-size:0.95rem;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:6px;}
.sw-item{font-size:0.88rem;color:var(--text2);padding:6px 0;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;}
.sw-item:last-child{border-bottom:none;}

/* Actions */
.results-actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:32px;}

/* ===== TOAST ===== */
.toast{
  position:fixed;bottom:100px;left:50%;transform:translateX(-50%);
  background:var(--panel);border:1px solid var(--border);
  border-radius:10px;padding:12px 24px;
  font-family:'DM Mono',monospace;font-size:0.85rem;
  color:var(--text);box-shadow:var(--shadow);z-index:999;
  opacity:0;pointer-events:none;
  transition:opacity 0.3s ease,transform 0.3s ease;
  white-space:nowrap;
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(-4px);}

