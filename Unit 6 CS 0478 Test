/* ============================================================
   STATE
   ============================================================ */
let state = {
  mcqs: [],
  shorts: [],
  longs: [],
  currentSection: 0, // 0=MCQ, 1=Short, 2=Long
  currentQuestion: 0,
  answers: {mcq:{}, short:{}, long:{}},
  submitted: false,
  timerInterval: null,
  timeLeft: 120 * 60, // 120 minutes
  scores: {mcq:0, short:0, long:0},
  topicScores: {},
  topicTotals: {},
};

/* ============================================================
   UTILITY
   ============================================================ */
function shuffle(arr){
  const a=[...arr];
  for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}
  return a;
}
function showToast(msg, duration=2500){
  const t=document.getElementById('toast');
  t.textContent=msg;t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),duration);
}
function openModal(title,body,confirmText,onConfirm){
  document.getElementById('modal-title').textContent=title;
  document.getElementById('modal-body').textContent=body;
  document.getElementById('modal-confirm').textContent=confirmText;
  document.getElementById('modal-confirm').onclick=onConfirm;
  document.getElementById('modal').classList.add('open');
}
function closeModal(){document.getElementById('modal').classList.remove('open');}

/* ============================================================
   TIMER
   ============================================================ */
function startTimer(){
  updateTimerDisplay();
  state.timerInterval=setInterval(()=>{
    state.timeLeft--;
    updateTimerDisplay();
    if(state.timeLeft<=0){clearInterval(state.timerInterval);autoSubmit();}
  },1000);
}
function updateTimerDisplay(){
  const d=document.getElementById('timer-display');
  const h=Math.floor(state.timeLeft/3600);
  const m=Math.floor((state.timeLeft%3600)/60);
  const s=state.timeLeft%60;
  d.textContent=`${h>0?h+':':''}${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  d.className='timer-display';
  if(state.timeLeft<=600) d.classList.add('danger');
  else if(state.timeLeft<=1200) d.classList.add('warning');
}
function autoSubmit(){showToast('⏰ Time is up! Submitting…');setTimeout(finalSubmit,1500);}

/* ============================================================
   EXAM INIT
   ============================================================ */
function startExam(){
  // Shuffle and select questions
  state.mcqs = shuffle(MCQ_BANK).slice(0,50);
  state.shorts = shuffle(SHORT_BANK).slice(0,20);
  state.longs = shuffle(LONG_BANK).slice(0,10);
  state.answers={mcq:{},short:{},long:{}};
  state.submitted=false;
  state.currentSection=0;
  state.currentQuestion=0;
  state.timeLeft=120*60;

  // Shuffle MCQ options
  state.mcqs=state.mcqs.map(q=>{
    const combined=q.opts.map((o,i)=>({text:o,isCorrect:i===q.ans}));
    const shuffled=shuffle(combined);
    return {...q, shuffledOpts:shuffled, shuffledAns:shuffled.findIndex(o=>o.isCorrect)};
  });

  document.getElementById('screen-landing').classList.add('hidden');
  document.getElementById('screen-exam').classList.add('active');
  startTimer();
  renderQuestion();
}

/* ============================================================
   RENDER
   ============================================================ */
function getQ(){
  if(state.currentSection===0) return state.mcqs[state.currentQuestion];
  if(state.currentSection===1) return state.shorts[state.currentQuestion];
  return state.longs[state.currentQuestion];
}
function getAnswer(){
  const keys=['mcq','short','long'];
  return state.answers[keys[state.currentSection]][state.currentQuestion];
}
function setAnswer(val){
  const keys=['mcq','short','long'];
  state.answers[keys[state.currentSection]][state.currentQuestion]=val;
}

const SECTION_META=[
  {label:'Section A – Multiple Choice',icon:'🔵',color:'var(--accent)',desc:'50 questions · 1 mark each · Select the best answer',bg:'rgba(56,189,248,0.07)'},
  {label:'Section B – Short Answer',icon:'🟣',color:'var(--accent2)',desc:'20 questions · 1–4 marks each · Write concise answers',bg:'rgba(129,140,248,0.07)'},
  {label:'Section C – Long Answer',icon:'🟢',color:'var(--accent3)',desc:'10 questions · 6–8 marks each · Extended response required',bg:'rgba(52,211,153,0.07)'},
];

function renderQuestion(){
  const body=document.getElementById('exam-body');
  const q=getQ();
  const sectionLengths=[state.mcqs.length,state.shorts.length,state.longs.length];
  const totalQ=sectionLengths.reduce((a,b)=>a+b,0);
  const doneQ=sectionLengths.slice(0,state.currentSection).reduce((a,b)=>a+b,0)+state.currentQuestion;

  // Progress
  document.getElementById('progress-fill').style.width=`${(doneQ/totalQ)*100}%`;
  const secName=['A – MCQ','B – Short','C – Long'][state.currentSection];
  document.getElementById('progress-label-left').textContent=`Section ${secName}`;
  document.getElementById('progress-label-right').textContent=`${doneQ} / ${totalQ}`;

  // Counter
  document.getElementById('q-counter').textContent=
    `Q${state.currentQuestion+1} of ${sectionLengths[state.currentSection]} | Section ${state.currentSection+1} of 3`;

  // Prev/Next/Submit
  const isFirst=state.currentSection===0&&state.currentQuestion===0;
  const isLast=state.currentSection===2&&state.currentQuestion===state.longs.length-1;
  document.getElementById('btn-prev').disabled=isFirst;
  document.getElementById('btn-next').disabled=isLast;
  document.getElementById('btn-submit').style.display=isLast?'block':'none';

  // Section banner only on first Q of section
  let sectionHTML='';
  if(state.currentQuestion===0){
    const m=SECTION_META[state.currentSection];
    sectionHTML=`<div class="section-banner" style="background:${m.bg};border-color:${m.color}33;">
      <div class="section-icon" style="background:${m.color}18;font-size:1.6rem;">${m.icon}</div>
      <div><h2 style="color:${m.color}">${m.label}</h2><p>${m.desc}</p></div>
    </div>`;
  }

  let cardHTML='';
  const ans=getAnswer();
  const submitted=state.submitted;

  if(state.currentSection===0){
    // MCQ
    const letters=['A','B','C','D'];
    const optHTML=q.shuffledOpts.map((opt,i)=>{
      let cls='mcq-option';
      let icon='';
      if(submitted){
        if(i===q.shuffledAns){cls+=' revealed-correct';icon='✓';}
        if(ans===i&&i!==q.shuffledAns){cls+=' incorrect';icon='✗';}
        if(ans===i&&i===q.shuffledAns){cls=' mcq-option correct';icon='✓';}
      } else {
        if(ans===i) cls+=' selected';
      }
      return `<div class="${cls}" onclick="${submitted?'':'selectMCQ('+i+')'}" style="${submitted?'cursor:default':''}">
        <div class="option-letter">${icon||letters[i]}</div>
        <div class="option-text">${opt.text}</div>
      </div>`;
    }).join('');

    let feedbackHTML='';
    if(submitted){
      const correct=ans===q.shuffledAns;
      const cls=correct?'correct-fb':'wrong-fb';
      feedbackHTML=`<div class="feedback-panel ${cls}">
        <div class="fb-header">
          ${correct?'<span style="color:var(--success)">✓ Correct!</span>':'<span style="color:var(--danger)">✗ Incorrect</span>'}
          <span class="fb-score">${correct?'1':'0'}/1</span>
        </div>
        ${!correct?`<div class="fb-model-answer"><strong>Correct Answer:</strong> ${q.shuffledOpts[q.shuffledAns].text}</div>`:''}
        <div class="examiner-note">Topic: ${q.topic}</div>
      </div>`;
    }

    cardHTML=`<div class="question-card ${ans!==undefined?'answered':''}">
      <div class="q-header">
        <span class="q-number">Q${state.currentQuestion+1}</span>
        <span class="q-marks">[1 mark]</span>
        <div class="q-text">${q.q}</div>
      </div>
      <div class="mcq-options">${optHTML}</div>
      ${feedbackHTML}
    </div>`;

  } else if(state.currentSection===1){
    // Short Answer
    let feedbackHTML='';
    if(submitted&&ans!==undefined){
      const res=gradeShort(q,ans);
      const cls=res.score===q.marks?'correct-fb':res.score>0?'partial-fb':'wrong-fb';
      const matchedHTML=res.matched.map(k=>`<span class="keyword-chip matched">✓ ${k}</span>`).join('');
      const missedHTML=res.missed.map(k=>`<span class="keyword-chip missed">✗ ${k}</span>`).join('');
      feedbackHTML=`<div class="feedback-panel ${cls}">
        <div class="fb-header">
          <span>${res.score===q.marks?'✓ Full Marks':res.score>0?'◑ Partial Credit':'✗ Insufficient'}</span>
          <span class="fb-score">${res.score}/${q.marks}</span>
        </div>
        <div class="fb-keywords">${matchedHTML}${missedHTML}</div>
        <div class="fb-model-answer"><strong>Model Answer:</strong> ${q.modelAnswer}</div>
        <div class="examiner-note">📋 ${q.examinerNote}</div>
      </div>`;
    } else if(submitted){
      feedbackHTML=`<div class="feedback-panel wrong-fb">
        <div class="fb-header"><span>✗ Not Attempted</span><span class="fb-score">0/${q.marks}</span></div>
        <div class="fb-model-answer"><strong>Model Answer:</strong> ${q.modelAnswer}</div>
      </div>`;
    }

    const readonly=submitted?'readonly':' ';
    cardHTML=`<div class="question-card ${ans?'answered':''}">
      <div class="q-header">
        <span class="q-number">Q${state.currentQuestion+1}</span>
        <span class="q-marks">[${q.marks} mark${q.marks>1?'s':''}]</span>
        <div class="q-text">${q.q}</div>
      </div>
      <textarea class="answer-box" id="ans-ta" placeholder="Write your answer here…" ${readonly}
        oninput="handleTextInput(this)">${ans||''}</textarea>
      <div class="char-count" id="char-count">${ans?(ans.length):0} characters</div>
      ${feedbackHTML}
    </div>`;

  } else {
    // Long Answer
    let feedbackHTML='';
    if(submitted&&ans!==undefined){
      const res=gradeLong(q,ans);
      const cls=res.score>=q.marks*0.75?'correct-fb':res.score>=q.marks*0.4?'partial-fb':'wrong-fb';
      const matchedHTML=res.matched.map(k=>`<span class="keyword-chip matched">✓ ${k}</span>`).join('');
      const missedHTML=res.missed.slice(0,8).map(k=>`<span class="keyword-chip missed">✗ ${k}</span>`).join('');
      const bandText=res.band;
      feedbackHTML=`<div class="feedback-panel ${cls}">
        <div class="fb-header">
          <span>Band: ${bandText}</span>
          <span class="fb-score">${res.score}/${q.marks}</span>
        </div>
        <div class="fb-keywords">${matchedHTML}${missedHTML}</div>
        <div class="fb-model-answer"><strong>Model Answer:</strong><br>${q.modelAnswer.replace(/\n/g,'<br>').replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>')}</div>
        <div class="examiner-note">📋 ${q.markScheme[0].band}: ${q.markScheme[0].desc}</div>
      </div>`;
    } else if(submitted){
      feedbackHTML=`<div class="feedback-panel wrong-fb">
        <div class="fb-header"><span>✗ Not Attempted</span><span class="fb-score">0/${q.marks}</span></div>
        <div class="fb-model-answer"><strong>Model Answer:</strong><br>${q.modelAnswer.replace(/\n/g,'<br>').replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>')}</div>
      </div>`;
    }

    const readonly=submitted?'readonly':'';
    cardHTML=`<div class="question-card ${ans?'answered':''}">
      <div class="q-header">
        <span class="q-number">Q${state.currentQuestion+1}</span>
        <span class="q-marks">[${q.marks} marks]</span>
        <div class="q-text">${q.q}</div>
      </div>
      <textarea class="answer-box long-answer" id="ans-ta" placeholder="Write your extended answer here (aim for at least 150 words)…" ${readonly}
        oninput="handleTextInput(this)">${ans||''}</textarea>
      <div class="char-count" id="char-count">${ans?(ans.length):0} characters</div>
      ${feedbackHTML}
    </div>`;
  }

  body.innerHTML=sectionHTML+cardHTML;
  body.scrollIntoView({behavior:'smooth',block:'start'});
}

/* ============================================================
   INTERACTIONS
   ============================================================ */
function selectMCQ(i){
  if(state.submitted) return;
  setAnswer(i);
  renderQuestion();
}
function handleTextInput(el){
  const val=el.value;
  setAnswer(val);
  const cc=document.getElementById('char-count');
  if(cc) cc.textContent=val.length+' characters';
}
function navigate(dir){
  // Save textarea content if open
  const ta=document.getElementById('ans-ta');
  if(ta) setAnswer(ta.value);

  const sectionLengths=[state.mcqs.length,state.shorts.length,state.longs.length];
  let sec=state.currentSection, q=state.currentQuestion;
  q+=dir;
  if(q<0){
    if(sec>0){sec--;q=sectionLengths[sec]-1;}
    else{q=0;}
  } else if(q>=sectionLengths[sec]){
    if(sec<2){sec++;q=0;}
    else{q=sectionLengths[sec]-1;}
  }
  state.currentSection=sec;
  state.currentQuestion=q;
  renderQuestion();
}
function requestSubmit(){
  const ta=document.getElementById('ans-ta');
  if(ta) setAnswer(ta.value);
  const total=state.mcqs.length+state.shorts.length+state.longs.length;
  const answered=Object.keys(state.answers.mcq).length+Object.keys(state.answers.short).length+Object.keys(state.answers.long).length;
  const unanswered=total-answered;
  openModal(
    'Submit Your Test',
    `You have answered ${answered} of ${total} questions. ${unanswered} question(s) are unanswered and will receive 0 marks. Are you sure you want to submit?`,
    'Submit Now',
    ()=>{closeModal();finalSubmit();}
  );
}
function confirmSubmit(){closeModal();finalSubmit();}

/* ============================================================
   GRADING
   ============================================================ */
function gradeShort(q, ans){
  const text=ans.toLowerCase();
  const allKeywords=[...new Set([...q.keywords,...q.coreKeywords])];
  const matched=allKeywords.filter(k=>text.includes(k.toLowerCase()));
  const missed=q.coreKeywords.filter(k=>!text.includes(k.toLowerCase()));
  // Score based on core keywords found
  const coreFound=q.coreKeywords.filter(k=>text.includes(k.toLowerCase())).length;
  const score=Math.min(q.marks, Math.round((coreFound/Math.max(q.coreKeywords.length,1))*q.marks));
  return {score, matched, missed, coreFound};
}

function gradeLong(q, ans){
  const text=ans.toLowerCase();
  const coreMatched=q.coreKeywords.filter(k=>text.includes(k.toLowerCase()));
  const suppMatched=q.supportingKeywords.filter(k=>text.includes(k.toLowerCase()));
  const coreRatio=coreMatched.length/Math.max(q.coreKeywords.length,1);
  const suppRatio=suppMatched.length/Math.max(q.supportingKeywords.length,1);
  const wordCount=(ans.trim().split(/\s+/).filter(Boolean)).length;
  const lengthBonus=wordCount>120?1:wordCount>60?0.5:0;

  // Raw score out of marks
  let raw=(coreRatio*0.65+suppRatio*0.25+Math.min(lengthBonus*0.1,0.1))*q.marks;
  raw=Math.min(q.marks,Math.max(0,Math.round(raw)));

  // Band
  const pct=raw/q.marks;
  let band='Level 1 (0–25%)';
  if(pct>=0.875) band='Level 4 (87.5–100%)';
  else if(pct>=0.625) band='Level 3 (62.5–87%)';
  else if(pct>=0.375) band='Level 2 (37.5–62%)';

  const matched=[...coreMatched,...suppMatched];
  const allMissed=[...q.coreKeywords,...q.supportingKeywords].filter(k=>!text.includes(k.toLowerCase()));

  return {score:raw, matched, missed:allMissed, band, coreRatio, suppRatio};
}

/* ============================================================
   FINAL SUBMIT & RESULTS
   ============================================================ */
function finalSubmit(){
  clearInterval(state.timerInterval);
  state.submitted=true;

  // Calculate MCQ score
  let mcqScore=0;
  state.mcqs.forEach((q,i)=>{
    const ans=state.answers.mcq[i];
    if(ans===q.shuffledAns) mcqScore++;
    // Topic tracking
    state.topicTotals[q.topic]=(state.topicTotals[q.topic]||0)+1;
    if(ans===q.shuffledAns) state.topicScores[q.topic]=(state.topicScores[q.topic]||0)+1;
  });

  // Calculate short score
  let shortScore=0, shortTotal=0;
  state.shorts.forEach((q,i)=>{
    shortTotal+=q.marks;
    const ans=state.answers.short[i];
    if(ans){
      const res=gradeShort(q,ans);
      shortScore+=res.score;
    }
    state.topicTotals[q.topic]=(state.topicTotals[q.topic]||0)+q.marks;
    if(ans){const res=gradeShort(q,ans);state.topicScores[q.topic]=(state.topicScores[q.topic]||0)+res.score;}
  });

  // Calculate long score
  let longScore=0, longTotal=0;
  state.longs.forEach((q,i)=>{
    longTotal+=q.marks;
    const ans=state.answers.long[i];
    if(ans){
      const res=gradeLong(q,ans);
      longScore+=res.score;
      state.topicScores[q.topic]=(state.topicScores[q.topic]||0)+res.score;
    }
    state.topicTotals[q.topic]=(state.topicTotals[q.topic]||0)+q.marks;
  });

  state.scores={
    mcq:mcqScore, mcqTotal:state.mcqs.length,
    short:shortScore, shortTotal,
    long:longScore, longTotal
  };

  const totalGot=mcqScore+shortScore+longScore;
  const totalPossible=state.mcqs.length+shortTotal+longTotal;

  // Save to localStorage
  localStorage.setItem('igcse_unit6_results', JSON.stringify({
    date:new Date().toISOString(),
    scores:state.scores,
    totalGot, totalPossible,
    topicScores:state.topicScores, topicTotals:state.topicTotals
  }));

  showResults(totalGot, totalPossible);
}

function getGrade(pct){
  if(pct>=90) return {g:'A*',cls:'grade-A-star'};
  if(pct>=80) return {g:'A',cls:'grade-A'};
  if(pct>=70) return {g:'B',cls:'grade-B'};
  if(pct>=60) return {g:'C',cls:'grade-C'};
  if(pct>=50) return {g:'D',cls:'grade-D'};
  return {g:'F',cls:'grade-F'};
}

function showResults(totalGot, totalPossible){
  document.getElementById('screen-exam').classList.remove('active');
  const rs=document.getElementById('screen-results');
  rs.classList.add('active');

  const pct=Math.round((totalGot/totalPossible)*100);
  const {g,cls}=getGrade(pct);
  const s=state.scores;
  const mcqPct=Math.round((s.mcq/s.mcqTotal)*100);
  const shortPct=Math.round((s.short/s.shortTotal)*100);
  const longPct=Math.round((s.long/s.longTotal)*100);

  const verdicts=['Outstanding performance – well above grade boundary.','Excellent work – showing strong command of Unit 6.','Good performance – secure understanding demonstrated.','Satisfactory – some key concepts need revisiting.','Borderline – significant revision needed across all topics.','Below grade boundary – thorough revision of Unit 6 required.'];
  const verdict=pct>=90?verdicts[0]:pct>=80?verdicts[1]:pct>=70?verdicts[2]:pct>=60?verdicts[3]:pct>=50?verdicts[4]:verdicts[5];

  // Topic analysis
  const allTopics=Object.keys(state.topicTotals);
  const topicHTML=allTopics.map(t=>{
    const got=state.topicScores[t]||0;
    const tot=state.topicTotals[t]||1;
    const tp=Math.round((got/tot)*100);
    const col=tp>=75?'var(--success)':tp>=50?'var(--warn)':'var(--danger)';
    return `<div class="topic-row">
      <div class="topic-name">${t}</div>
      <div class="topic-bar-wrap"><div class="topic-bar-fill" style="width:${tp}%;background:${col}"></div></div>
      <div class="topic-pct">${tp}%</div>
    </div>`;
  }).join('');

  // Strengths/weaknesses
  const sorted=allTopics.map(t=>({t,p:Math.round(((state.topicScores[t]||0)/(state.topicTotals[t]||1))*100)})).sort((a,b)=>b.p-a.p);
  const strengths=sorted.filter(x=>x.p>=65).slice(0,4);
  const weaknesses=sorted.filter(x=>x.p<65).slice(0,4);

  const swHTML=`<div class="sw-grid">
    <div class="sw-card strength">
      <h4 style="color:var(--success)">💪 Strengths</h4>
      ${strengths.length?strengths.map(s=>`<div class="sw-item"><span>✓</span>${s.t} (${s.p}%)</div>`).join(''):'<div class="sw-item">Complete more questions to see strengths.</div>'}
    </div>
    <div class="sw-card weakness">
      <h4 style="color:var(--danger)">📚 Areas to Revise</h4>
      ${weaknesses.length?weaknesses.map(w=>`<div class="sw-item"><span>✗</span>${w.t} (${w.p}%)</div>`).join(''):'<div class="sw-item">No significant weaknesses detected.</div>'}
    </div>
  </div>`;

  document.getElementById('results-container').innerHTML=`
    <div style="text-align:center;margin-bottom:32px;">
      <div class="header-brand" style="font-size:1rem;display:inline-block;margin-bottom:8px;">📋 IGCSE CS 0478 · Unit 6 · Test Results</div>
    </div>

    <div class="results-hero">
      <div class="grade-badge ${cls}">${g}</div>
      <div class="total-score">${totalGot}<span>/${totalPossible}</span></div>
      <div class="total-score" style="font-size:1.8rem;">${pct}%</div>
      <div class="result-verdict">${verdict}</div>
    </div>

    <div class="results-grid">
      <div class="result-card mcq-card">
        <div class="rc-label">Section A · MCQs</div>
        <div class="rc-score" style="color:var(--accent)">${s.mcq}/${s.mcqTotal}</div>
        <div class="rc-pct">${mcqPct}% · 1 mark each</div>
        <div class="rc-bar"><div class="rc-bar-fill" style="width:${mcqPct}%"></div></div>
      </div>
      <div class="result-card short-card">
        <div class="rc-label">Section B · Short Answers</div>
        <div class="rc-score" style="color:var(--accent2)">${s.short}/${s.shortTotal}</div>
        <div class="rc-pct">${shortPct}% · Keyword matching</div>
        <div class="rc-bar"><div class="rc-bar-fill" style="width:${shortPct}%"></div></div>
      </div>
      <div class="result-card long-card">
        <div class="rc-label">Section C · Long Answers</div>
        <div class="rc-score" style="color:var(--accent3)">${s.long}/${s.longTotal}</div>
        <div class="rc-pct">${longPct}% · Band-based marking</div>
        <div class="rc-bar"><div class="rc-bar-fill" style="width:${longPct}%"></div></div>
      </div>
    </div>

    <div class="topic-section">
      <h3>📊 Topic Performance Breakdown</h3>
      ${topicHTML}
    </div>

    ${swHTML}

    <div class="topic-section">
      <h3>🎯 Grade Boundaries (IGCSE Estimate)</h3>
      <div class="topic-row"><div class="topic-name" style="color:var(--gold)">A* (≥90%)</div><div class="topic-bar-wrap"><div class="topic-bar-fill" style="width:100%;background:var(--gold)"></div></div><div class="topic-pct">90%+</div></div>
      <div class="topic-row"><div class="topic-name" style="color:var(--accent)">A (≥80%)</div><div class="topic-bar-wrap"><div class="topic-bar-fill" style="width:89%;background:var(--accent)"></div></div><div class="topic-pct">80–89%</div></div>
      <div class="topic-row"><div class="topic-name" style="color:var(--accent2)">B (≥70%)</div><div class="topic-bar-wrap"><div class="topic-bar-fill" style="width:78%;background:var(--accent2)"></div></div><div class="topic-pct">70–79%</div></div>
      <div class="topic-row"><div class="topic-name" style="color:var(--accent3)">C (≥60%)</div><div class="topic-bar-wrap"><div class="topic-bar-fill" style="width:65%;background:var(--accent3)"></div></div><div class="topic-pct">60–69%</div></div>
      <div class="topic-row"><div class="topic-name" style="color:var(--warn)">D (≥50%)</div><div class="topic-bar-wrap"><div class="topic-bar-fill" style="width:54%;background:var(--warn)"></div></div><div class="topic-pct">50–59%</div></div>
      <div style="margin-top:12px;padding:12px 16px;background:${cls.includes('A-star')?'rgba(251,191,36,0.1)':cls.includes('grade-A')?'rgba(56,189,248,0.1)':cls.includes('grade-B')?'rgba(129,140,248,0.1)':cls.includes('grade-C')?'rgba(52,211,153,0.1)':cls.includes('grade-D')?'rgba(251,146,60,0.1)':'rgba(248,113,113,0.1)'};border-radius:8px;font-family:'DM Mono',monospace;font-size:0.9rem;">
        Your estimated grade: <strong style="color:${cls.includes('A-star')?'var(--gold)':cls.includes('grade-A')?'var(--accent)':cls.includes('grade-B')?'var(--accent2)':cls.includes('grade-C')?'var(--accent3)':cls.includes('grade-D')?'var(--warn)':'var(--danger)'}">${g}</strong> (${pct}%)
      </div>
    </div>

    <div class="results-actions">
      <button class="btn-primary" onclick="retakeTest()">↺ Retake Test</button>
      <button class="btn-secondary" onclick="reviewAnswers()">📝 Review Answers</button>
      <button class="btn-secondary" onclick="returnHome()">🏠 Home</button>
    </div>
  `;

  // Animate bars
  setTimeout(()=>{
    document.querySelectorAll('.rc-bar-fill,.topic-bar-fill').forEach(el=>{
      const w=el.style.width;el.style.width='0%';
      requestAnimationFrame(()=>requestAnimationFrame(()=>el.style.width=w));
    });
  },100);
}

function retakeTest(){
  state.topicScores={};state.topicTotals={};
  document.getElementById('screen-results').classList.remove('active');
  startExam();
}
function returnHome(){
  document.getElementById('screen-results').classList.remove('active');
  document.getElementById('screen-landing').classList.remove('hidden');
}
function reviewAnswers(){
  state.currentSection=0;state.currentQuestion=0;
  document.getElementById('screen-results').classList.remove('active');
  document.getElementById('screen-exam').classList.add('active');
  renderQuestion();
  showToast('📝 Reviewing answers – all sections now showing feedback');
}
function loadPrevious(){
  const data=localStorage.getItem('igcse_unit6_results');
  if(!data){showToast('No previous results found');return;}
  const r=JSON.parse(data);
  const d=new Date(r.date).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
  showToast(`Last attempt: ${d} — ${r.totalGot}/${r.totalPossible} (${Math.round(r.totalGot/r.totalPossible*100)}%)`);
}

/* ============================================================
   ANTI-CHEAT (optional)
   ============================================================ */
document.addEventListener('contextmenu',e=>e.preventDefault());
document.addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&['u','s','p','a'].includes(e.key.toLowerCase())){e.preventDefault();}
});

// Prevent copy in exam mode (disabled in review)
document.addEventListener('copy',e=>{
  if(!state.submitted&&document.getElementById('screen-exam').classList.contains('active')){
    e.preventDefault();showToast('⚠️ Copying disabled during exam');
  }
});

/* Visibility change warning */
let visWarnings=0;
document.addEventListener('visibilitychange',()=>{
  if(document.hidden&&!state.submitted&&document.getElementById('screen-exam').classList.contains('active')){
    visWarnings++;showToast(`⚠️ Warning ${visWarnings}: Tab switching detected`);
  }
});
</script>
